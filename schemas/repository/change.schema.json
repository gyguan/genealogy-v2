{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "title", "lifecycle", "authority", "status", "affected_domains", "gates", "artifacts"],
  "properties": {
    "id": {"pattern": "^CHG-[0-9]{4}$"},
    "title": {"type": "string", "minLength": 1},
    "lifecycle": {"enum": ["draft", "review", "approved", "superseded", "archived"]},
    "authority": {"enum": ["canonical", "provisional", "reference", "generated"]},
    "status": {"type": "string"},
    "affected_domains": {"type": "array", "items": {"type": "string"}},
    "gates": {"type": "object"},
    "artifacts": {"type": "object"}
  },
  "additionalProperties": true
}
